generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  phone    String? @unique
  password String?

  address String?
  zipCode String?

  // 🔥 New Relations
  countryId Int?
  stateId   Int?
  cityId    Int?

  country Country? @relation(fields: [countryId], references: [id])
  state   State?   @relation(fields: [stateId], references: [id])
  city    City?    @relation(fields: [cityId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isActive        Boolean   @default(true)
  deletedAt       DateTime?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  // Relations
  userRoles          UserRole[]
  refreshTokens      RefreshToken[]
  oauthAccounts      OAuthAccount[]
  verificationTokens VerificationToken[]

  @@index([email])
  @@index([phone])
  @@index([countryId])
  @@index([stateId])
  @@index([cityId])
}

model Role {
  id        Int        @id @default(autoincrement())
  code      String     @unique @db.VarChar(50)
  name      String     @unique @db.VarChar(100)
  createdAt DateTime   @default(now())
  userRoles UserRole[]
}

model UserRole {
  id     Int  @id @default(autoincrement())
  userId Int
  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OAuthAccount {
  id             Int      @id @default(autoincrement())
  provider       String
  providerUserId String
  userId         Int
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model VerificationToken {
  id        Int              @id @default(autoincrement())
  token     String           @unique
  userId    Int
  type      VerificationType
  expiresAt DateTime
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Country {
  id             Int      @id @default(autoincrement())
  name           String
  iso3           String?  @db.Char(3)
  numericCode    String?  @map("numeric_code") @db.Char(3)
  iso2           String?  @db.Char(2)
  phonecode      String?
  capital        String?
  currency       String?
  currencyName   String?  @map("currency_name")
  currencySymbol String?  @map("currency_symbol")
  tld            String?
  native         String?
  population     BigInt?
  gdp            BigInt?
  nationality    String?
  timezones      Json?
  translations   Json?
  latitude       Decimal? @db.Decimal(15, 8)
  longitude      Decimal? @db.Decimal(15, 8)
  emoji          String?
  emojiU         String?
  wikiDataId     String?
  flag           Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  users          User[]
  cities         City[]
  states         State[]

  @@map("countries")
}

model State {
  id           Int      @id @default(autoincrement())
  name         String
  countryCode  String   @map("country_code")
  fipsCode     String?  @map("fips_code")
  iso2         String?
  iso3166_2    String?
  type         String?
  level        Int?
  parentId     Int?     @map("parent_id")
  native       String?
  latitude     Decimal? @db.Decimal(15, 8)
  longitude    Decimal? @db.Decimal(15, 8)
  timezone     String?
  translations Json?
  wikiDataId   String?
  flag         Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  countryId    Int      @map("country_id")
  users        User[]
  cities       City[]
  country      Country  @relation(fields: [countryId], references: [id])

  @@index([countryId])
  @@map("states")
}

model City {
  id           Int      @id @default(autoincrement())
  name         String
  stateCode    String   @map("state_code")
  countryCode  String   @map("country_code")
  latitude     Decimal  @db.Decimal(15, 8)
  longitude    Decimal  @db.Decimal(15, 8)
  native       String?
  timezone     String?
  translations Json?
  wikiDataId   String?
  flag         Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  stateId      Int      @map("state_id")
  countryId    Int      @map("country_id")
  users        User[]
  country      Country  @relation(fields: [countryId], references: [id])
  state        State    @relation(fields: [stateId], references: [id])

  @@index([stateId])
  @@index([countryId])
  @@map("cities")
}

enum VerificationType {
  EMAIL
  PHONE
  FORGOT_PASSWORD
  VERIFY_ACCOUNT
}
