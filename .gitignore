# ===========================================
# 🟦 MONOREPO ROOT GITIGNORE
# Covers: frontend, backend services, ml-service
# ===========================================

# -------------------------
# Node.js (frontend + services)
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
pnpm-lock.yaml
yarn.lock

# Dist / Build Output
dist/
build/
out/
.vite/
.vite-inspect/

# Vite PWA generated files
public/sw.js
public/sw.js.map
public/workbox-*
public/manifest.webmanifest

# -------------------------
# Logs
# -------------------------
logs/
*.log
*.log.*
npm-debug.log*
debug.log
error.log

# -------------------------
# Environment Variables
# -------------------------
.env
.env.*
!important
# (We will commit example templates like `.env.example` manually)

# -------------------------
# Editor folders
# -------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# -------------------------
# Mac / OS / Misc files
# -------------------------
.DS_Store
Thumbs.db

# -------------------------
# Python (ML service)
# -------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
ENV/
venv.bak/
.ipynb_checkpoints/

# pip cache
pip-log.txt
pip-delete-this-directory.txt

# FastAPI / Uvicorn cache
*.db

# -------------------------
# Docker
# -------------------------
docker-data/
docker-compose.override.yml
*.pid

# -------------------------
# Prisma (backend services)
# -------------------------
prisma/migrations/.cache
prisma/migrations/*/migration.sql.generated
prisma/*-lock.json

# SQLite files (if any microservice uses fallback DB)
*.sqlite
*.sqlite-journal

# -------------------------
# Coverage
# -------------------------
coverage/
*.lcov

# -------------------------
# Temporary files
# -------------------------
tmp/
temp/
*.tmp
*.temp

# -------------------------
# PWA Icons (will generate via script)
# (optional: ignore if auto-generated)
# -------------------------
public/pwa-*.png

# -------------------------
# Misc
# -------------------------
*.tsbuildinfo
frontend/.eslintcache
services/**/.eslintcache
ml-service/.pytest_cache



